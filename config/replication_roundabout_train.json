  "output_dir": "experiments/replication_v2/roundabout",
  "conditions": ["history_only", "shuffled_full", "prefix_10"],
  "coordinate_transform": "episode_anchor_relative",
  "shuffle_match": ["split", "factual_action_0", "cf_action", "cf_duration"],
  "shuffle_seed": 20260917,
